<header class="bg-white border-b px-6 py-3 flex items-center justify-between">

            <!-- Search -->
            <form action="/dashboard" method="GET" class="w-full flex">
                <div class="relative w-full sm:max-w-md min-w-0">
                    <input
                        type="text"
                        name="search"
                        placeholder="Search notes..."
                        class="w-full min-w-0 pl-10 pr-4 py-2 border rounded-lg
                            focus:ring-2 focus:ring-teal-500 focus:outline-none"
                    />
                    <span class="absolute left-3 top-2.5 text-gray-400">🔍</span>
                </div>
            </form>


            <!-- Right Actions -->
            <div class="flex items-center gap-4">

                <a href="/notes/new" class="inline-flex items-center justify-center gap-2 bg-orange-500 hover:bg-orange-600 text-white px-4 py-2 rounded-lg text-sm font-medium whitespace-nowrap">
                    New Note
                </a>

                <!-- Profile Dropdown -->
                <%- include('profileSection')  %>

            </div>
        </header>
