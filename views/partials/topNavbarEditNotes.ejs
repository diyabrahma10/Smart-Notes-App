<header
  class="bg-white/80 backdrop-blur-md border-b border-gray-50 sticky top-0 z-50"
>
  <div class="max-w-4xl mx-auto px-8 h-16 flex items-center justify-between">
    <div class="flex items-center space-x-4">
      <div class="h-4 w-[2px] bg-teal-500 rounded-full"></div>
      <span class="text-[10px] text-gray-400 font-bold uppercase tracking-[0.2em]"
        >Editor</span
      >
    </div>

    <div class="flex items-center space-x-3">
      <div id="save-status" class="hidden text-[10px] font-bold text-gray-300 uppercase mr-2 tracking-widest">
        <i class="fas fa-check-circle mr-1"></i> Saved
      </div>
      <div class="h-8 w-[1px] bg-gray-100 mx-2"></div>
      
      <button 
        form="note-form"
        type="submit"
        name="action"
        value="delete"
        class="text-gray-400 hover:text-red-500 p-2 transition-colors"
      >
        <i class="far fa-trash-alt"></i>
      </button>
      <button
        form="note-form"
        type="submit"
        name="action"
        value="save"
        class="bg-teal-600 text-white px-6 py-2 rounded-xl text-xs font-bold hover:bg-teal-700 shadow-sm hover:shadow-teal-100 transition-all flex items-center whitespace-nowrap"
      >
        <i class="fas fa-save mr-2"></i> Save Changes
      </button>
    </div>
  </div>
</header>
