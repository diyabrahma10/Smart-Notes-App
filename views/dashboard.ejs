<%- include('partials/head') %>

<nav class="bg-white shadow-sm border-b">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16 items-center">
            <div class="text-2xl font-bold text-teal-600">SmartNotes</div>
            <div class="flex items-center space-x-4">
                <span class="text-gray-600">Hello, <strong><%= user.username %></strong></span>
                <a href="/logout" class="text-sm text-red-500 hover:text-red-700">Logout</a>
            </div>
        </div>
    </div>
</nav>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-2xl font-bold text-gray-800">My Notes</h1>
        <a href="/notes/new" class="bg-teal-600 text-white px-4 py-2 rounded-lg hover:bg-teal-700 transition-colors flex items-center">
            <i class="fas fa-plus mr-2"></i> New Note
        </a>
    </div>

    <div class="max-w-7xl mx-auto mb-6">
      <%- include('partials/successMessage') %>
      <%- include('partials/errorMessage') %>
    </div>

    <% if (typeof notes !== 'undefined' && notes.length > 0) { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <% notes.forEach(note => { %>
                <div class="bg-white p-6 rounded-3xl shadow-xl border border-gray-200 hover:shadow-2xl transition-all">
                    <div class="flex justify-between items-start gap-4">
                        <a href="/notes/<%= note.id %>" class="text-xl font-semibold text-gray-900 mb-2 truncate block w-full hover:text-teal-600 transition-colors">
                            <%= note.title || 'Untitled Note' %>
                        </a>
                        <form action="/notes/<%= note.id %>/delete" method="post" class="shrink-0">
                            <button type="submit" class="bg-red-600 text-white px-3 py-2 rounded-lg text-sm font-semibold hover:bg-red-700 transition-colors">
                                Delete
                            </button>
                        </form>
                    </div>
                    <p class="text-gray-600 text-sm leading-6 mt-3 line-clamp-4">
                        <%= note.contentText ? note.contentText : 'No content yet...' %>
                    </p>
                    <div class="mt-5 flex items-center justify-between text-xs text-gray-400">
                        <span>Updated <%= new Date(note.updatedAt).toLocaleDateString() %></span>
                        <span><%= note.tags?.length ? note.tags.length + ' tags' : '' %></span>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <div class="text-center py-20 bg-white rounded-xl border-2 border-dashed border-gray-200">
            <div class="text-gray-400 mb-4">
                <i class="fas fa-sticky-note text-5xl"></i>
            </div>
            <h2 class="text-xl font-medium text-gray-600">You don't have any notes yet.</h2>
            <p class="text-gray-400 mt-1">Start by creating your first note!</p>
        </div>
    <% } %>
</main>

</body>
</html>